# Scraping Configuration
DOWNLOAD_DELAY=3
RANDOMIZE_DOWNLOAD_DELAY=True
CONCURRENT_REQUESTS=1

# Selenium Configuration
SELENIUM_HEADLESS=True
SELENIUM_TIMEOUT=30

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/aoty_crawler.log

# Rate Limiting
RETRY_TIMES=3
RETRY_HTTP_CODES=500,502,503,504,408,429,403

# User Agent
USER_AGENT=AOTY-Crawler/1.0 (Personal Project; Music Data Collection)

# Data Processing
MAX_ITEMS=10000
EXPORT_FORMAT=csv

# --- Radius (album similarity) ---
# No API key needed: MusicBrainz, ListenBrainz and Wikipedia are all keyless.
# Tell them who is calling, so an operator can reach you if a run misbehaves.
RADIUS_CONTACT=https://github.com/cpet02/aoty-crawler
# Request rates. MusicBrainz publish a hard limit of 1/sec; don't raise it.
RADIUS_MB_RPS=1
RADIUS_LB_RPS=4
