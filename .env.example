# Scraping Configuration
DOWNLOAD_DELAY=3
RANDOMIZE_DOWNLOAD_DELAY=True
CONCURRENT_REQUESTS=1

# Selenium Configuration
SELENIUM_HEADLESS=True
SELENIUM_TIMEOUT=30

# FlareSolverr Configuration (bypasses Cloudflare verification challenges)
# Run FlareSolverr separately, e.g.:
#   docker run -d --name flaresolverr -p 8191:8191 ghcr.io/flaresolverr/flaresolverr:latest
# Then set FLARESOLVERR_ENABLED = True in aoty_crawler/settings.py
FLARESOLVERR_ENABLED=False
FLARESOLVERR_URL=http://localhost:8191/v1
FLARESOLVERR_TIMEOUT=60

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/aoty_crawler.log

# Rate Limiting
RETRY_TIMES=3
RETRY_HTTP_CODES=500,502,503,504,408,429,403

# User Agent
USER_AGENT=AOTY-Crawler/1.0 (Personal Project; Music Data Collection)

# Data Processing
MAX_ITEMS=10000
EXPORT_FORMAT=csv
