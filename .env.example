# Radius configuration. Copy to .env and paste your keys below; that is all
# the setup there is. Every key is optional: leave one blank and Radius runs
# without that service's extras.

# Last.fm API key. Thickens tag vectors (especially mood), adds Last.fm
# similar artists as a candidate source and Last.fm listener counts.
# Get one at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Discogs consumer key and secret, from a registered app at
# https://www.discogs.com/settings/developers. Discogs works without them at
# 25 requests/minute; with them it runs at 60/minute and Discogs enrichment
# is on by default. A personal access token (DISCOGS_TOKEN=) does the same
# job, if you would rather generate one of those instead.
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=

# Tell the services who is calling, so an operator can reach you if a run
# ever misbehaves. Your email or repo URL.
RADIUS_CONTACT=https://github.com/cpet02/aoty-crawler

# Request rates, per second. MusicBrainz and ListenBrainz both ask for no
# more than 1; don't raise either. Deezer allows 50 per 5 seconds.
RADIUS_MB_RPS=1
RADIUS_LB_RPS=1
RADIUS_WIKIDATA_RPS=4
RADIUS_DEEZER_RPS=5
RADIUS_LASTFM_RPS=4
# Discogs is per minute, and defaults to 25 keyless or 60 with credentials.
# Setting it here overrides that choice.
#RADIUS_DISCOGS_RPM=25
