# Radius (album similarity)
# No API key needed: MusicBrainz, ListenBrainz and Wikipedia are all keyless.
# Tell them who is calling, so an operator can reach you if a run misbehaves.
RADIUS_CONTACT=https://github.com/cpet02/aoty-crawler

# Request rates. MusicBrainz publish a hard limit of 1/sec; don't raise it.
RADIUS_MB_RPS=1
RADIUS_LB_RPS=4

# Optional: thickens tag vectors with Last.fm's crowd tags. Purely additive —
# delete it and everything still runs, with thinner tags. Get one at
# https://www.last.fm/api/accounts
LASTFM_API_KEY=
