# Radius configuration. Nothing here is required: every service Radius uses
# is keyless. Copy to .env to override defaults.

# Tell the services who is calling, so an operator can reach you if a run
# ever misbehaves. Your email or repo URL.
RADIUS_CONTACT=https://github.com/cpet02/aoty-crawler

# Optional: Last.fm API key. Thickens tag vectors (especially mood), adds
# Last.fm similar artists as a candidate source and Last.fm listener counts.
# Get one at https://www.last.fm/api/account/create
#LASTFM_API_KEY=

# Optional: Discogs personal access token. Discogs works without one at
# 25 requests/minute; a token raises that to 60/minute and switches Discogs
# enrichment on by default. https://www.discogs.com/settings/developers
#DISCOGS_TOKEN=

# Request rates, per second. MusicBrainz publish a hard limit of 1; don't
# raise it. Deezer allows 50 per 5 seconds; Discogs is per minute.
RADIUS_MB_RPS=1
RADIUS_LB_RPS=4
RADIUS_WIKIDATA_RPS=4
RADIUS_DEEZER_RPS=5
RADIUS_LASTFM_RPS=4
RADIUS_DISCOGS_RPM=25
